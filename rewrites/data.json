 "cards": [
  {
   "app": "fsharp",
   "n": "01 · the port",
   "title": "The F# port",
   "tagline": "Translate it, <em>byte for byte</em>.",
   "rule": "Do the same work per request as Basecamp's Rust port, and render every screen byte-identical to it.",
   "body": "Translated crate by crate from the Rust port by phased agent workflows: its own front server, SQLite layer, HTML writer and HTML5 parser, all in F#. It matched every parity screen byte for byte, then ran {port_vs_pinned} the Rust port it was translated from. Basecamp's Rust has since added full-page caching, so on today's harness the port does {room_x_rust} Rust on the room page.",
   "pills": [
    "F#",
    "ASP.NET Core",
    "Falco",
    "Own front server",
    "Own SQLite layer",
    "html5ever port"
   ],
   "parity": [
    "214/214",
    "states byte-identical to Rust",
    "port_parity"
   ]
  },
  {
   "app": "oncrack",
   "n": "02 · onCrack",
   "title": "onCrack",
   "tagline": "Same pixels, <em>no speed limit</em>.",
   "rule": "Do any work you like, as long as every screen stays pixel-identical to Rails and no one ever sees a stale page or someone else's.",
   "body": "Versioned page caches that re-check the session and room membership on every hit, group commit for concurrent posts, cache hits answered by the front server, gathered Cable writes, and a Cable log that keeps every reader. The fastest of the six in every workload, and in Basecamp's 1,000-client Cable test it cut {onc_cut} clients where Rust cut {rust_cut}. It pays in memory, and it is the largest of the three.",
   "pills": [
    "F#",
    "Versioned page cache",
    "Group commit",
    "Front-server hits",
    "Gathered sendmsg",
    "Native AOT"
   ],
   "parity": [
    "944/944",
    "screenshots equal to Rails",
    "onc_parity"
   ]
  },
  {
   "app": "dotnetway",
   "n": "03 · theDotNetWay",
   "title": "theDotNetWay",
   "tagline": "Let the <em>framework</em> do it.",
   "rule": "Write it the way a .NET team would: the standard piece for every layer, hand-written code only where Rails parity demands it.",
   "body": "Forked from the port and rebuilt one layer at a time behind the pixel gate: Kestrel and ASP.NET Core middleware for the front server, EF Core with Dapper on the hot reads, Falco.Markup views, AngleSharp for HTML, WebSockets with Channel&lt;T&gt; for Cable, HybridCache for pages. The smallest of the three and smaller than Rust; slower than Rust, C and onCrack.",
   "pills": [
    "F#",
    "Kestrel",
    "EF Core",
    "Dapper",
    "Falco.Markup",
    "AngleSharp",
    "HybridCache"
   ],
   "parity": [
    "4,918/4,918",
    "pixel cells equal to Rails",
    "dnw_parity"
   ]
  }
 ],
